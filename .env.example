# ===== copy to .env on the server and edit every line marked CHANGE =====
DEBUG=0
SECRET_KEY=CHANGE-run-openssl-rand-base64-48
DOMAIN=CHANGE-yourdomain.com
ALLOWED_HOSTS=CHANGE-yourdomain.com,www.yourdomain.com
BASE_URL=https://CHANGE-yourdomain.com
CSRF_TRUSTED_ORIGINS=https://CHANGE-yourdomain.com
NUM_PROXIES=1
WEB_WORKERS=4
REDIS_URL=redis://redis:6379/1
MEDIA_ROOT=/app/media
SENTRY_DSN=
# database (the same values create the Postgres database on first start)
POSTGRES_DB=loop
POSTGRES_USER=loop
POSTGRES_PASSWORD=CHANGE-long-random
POSTGRES_HOST=db
# Razorpay (Dashboard > Settings > API Keys; webhook: https://DOMAIN/api/billing/webhook/)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# our own UPI QR/ID for manual payments
PLATFORM_UPI_ID=
PLATFORM_UPI_NAME=LoopRewards
# GST invoice header
GST_RATE=18
SELLER_NAME=Your Company Pvt Ltd
SELLER_GSTIN=
SELLER_ADDRESS=
# SMS/WhatsApp bridge (POST {"mobile","text"}); empty = log only
NOTIFY_WEBHOOK_URL=
NOTIFY_SMS=0
COMMISSION_FIRST_YEAR_ONLY=0
# optional offsite backups: an rclone remote, e.g. contabo:looprewards-backups
RCLONE_REMOTE=
# legal pages (shown on /privacy /terms /refund /contact) - set real values before launch
SUPPORT_EMAIL=
SUPPORT_PHONE=
GRIEVANCE_NAME=Grievance Officer
GRIEVANCE_EMAIL=
JURISDICTION=Mumbai, Maharashtra
LEGAL_UPDATED=1 January 2027
HOSTING_REGION=India / Europe (Contabo data centre)
# data kept this many months after a shop's plan + pause ends; AUTO_PURGE=1 lets the daily job delete it (default: dry-run only)
RETENTION_MONTHS=12
AUTO_PURGE=0
